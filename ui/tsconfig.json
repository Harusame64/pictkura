{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    // `src/i18n/` の中だけ相対 import に `.ts` を書いている。
    // **辞書の検査（`scripts/i18n.test.ts`）を `node --test` で走らせるため**——
    // Node の ESM は拡張子を補わないので、拡張子なしだと辞書を読めない。
    // ローダのフックを足すより、書いてあるとおりに解決できる形にした
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  // **`scripts` も型を見る**（2026-09-02、ゲート2の指摘）。辞書を守っているのが
  // `scripts/i18n.test.ts` なのに、そこだけ `tsc -b` の外に居た——テストの誤字が
  // CI の実行時エラーでしか出ない状態だった。`@types/node` はそのために入れている
  // （型だけ。バンドルには何も乗らない）
  "include": ["src", "scripts"]
}
