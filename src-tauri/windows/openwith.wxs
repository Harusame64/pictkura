<?xml version="1.0" encoding="utf-8"?>
<!--
  「プログラムから開く」の候補に pictkura を載せるための WiX 断片（2026-11-15 利用者の決定。dev/plan.md の同日の節）。

  **既定のアプリは取りに行かない。** 書くのは候補だけ——拡張子ごとの OpenWithProgids と、Applications の
  SupportedTypes。UserChoice（既定）には触らない（Windows も、アプリが既定を書き換えることを許していない）。
  ダブルクリックで開くのは利用者が「常にこのアプリで開く」を選んだときだけ。

  開くと、写真のパスを引数に起動する（受け側は open_path_from_args。引数は MSI・NSIS・Store 版で同じ）。拡張子は
  取り込みの既定の一覧（config.rs の default extensions）と同じ。AutoPlay の断片（autoplay.wxs）と同じく per-machine
  なので HKLM に書き、アンインストールで MSI が自分で消す。

  注意: XML のコメントにはハイフン2つを書けない。この断片は scripts で作ったものではなく手で直してよいが、拡張子の
  一覧は installer-hooks.nsh・msix/AppxManifest.xml と揃えること。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OpenWithRegistration" Guid="B8F2D3A1-6C4E-4F7B-9A2D-3E5C1F8B7D24" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\pictkura.Image">
          <RegistryValue Type="string" Value="pictkura" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="pictkura" />
        </RegistryKey>
