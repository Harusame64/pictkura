<?xml version="1.0" encoding="utf-8"?>
<!--
  「プログラムから開く」の候補に pictkura を載せるための WiX 断片（2026-11-15 利用者の決定。dev/plan.md の同日の節）。

  **既定のアプリは取りに行かない。** 書くのは候補だけ——拡張子ごとの OpenWithProgids と、Applications の
  SupportedTypes。UserChoice（既定）には触らない（Windows も、アプリが既定を書き換えることを許していない）。
  **ProgID に AllowSilentDefaultTakeOver を付ける（外さないこと）。** 利用者が既定を選んだ記録の無い拡張子は、
  候補がちょうど 1 つ（例: .cr3 のフォト）だとそれが既定として使われている。印の無い 2 つ目の候補を足すと、Windows は
  「アプリの選択」に落ちて、フォトで開かなくなる（2026-11-16 win2 の対照: .cr3 で印なし→不明、印あり→フォトのまま、
  付け外しで再現。HKCU でも HKLM でも同じ）。代わりに pictkura は「おすすめ」から外れ、「別のアプリを選択」の中に出る。
  候補が 0 だった拡張子（実測では .arq・.x3f）は、印があっても pictkura で開く（利用者が了承）
  ダブルクリックで開くのは利用者が「常にこのアプリで開く」を選んだときだけ。

  開くと、写真のパスを引数に起動する（受け側は open_path_from_args。引数は MSI・NSIS・Store 版で同じ）。拡張子は
  取り込みの既定の一覧（config.rs の default extensions）と同じ。AutoPlay の断片（autoplay.wxs）と同じく per-machine
  なので HKLM に書き、アンインストールで MSI が自分で消す。

  注意: XML のコメントにはハイフン2つを書けない。拡張子の一覧は下の foreach の 1 か所で、installer-hooks.nsh の
  PK_OPENWITH_EXTS・msix/AppxManifest.xml と揃える（lib.rs の試験が 3 つと取り込みの既定の一覧を照らす）。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OpenWithRegistration" Guid="B8F2D3A1-6C4E-4F7B-9A2D-3E5C1F8B7D24" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\pictkura.Image">
          <RegistryValue Type="string" Value="pictkura" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="pictkura" />
          <!-- 他のアプリの既定を崩さないための印（上の説明。文書は REG_NONE だが、実測したのは空の文字列） -->
          <RegistryValue Name="AllowSilentDefaultTakeOver" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\pictkura.Image\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLDIR]pictkura.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\pictkura.Image\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]pictkura.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pictkura.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="pictkura" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pictkura.exe\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]pictkura.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <!-- 拡張子の一覧（**ここ 1 か所**。installer-hooks.nsh の PK_OPENWITH_EXTS・AppxManifest.xml と揃える。lib.rs の試験が見る） -->
        <?foreach EXT in jpg;jpeg;png;webp;cr2;cr3;crw;nef;nrw;arw;srf;sr2;arq;raf;orf;ori;rw2;pef;ptx;srw;dng;raw;rwl;3fr;fff;iiq;erf;mrw;x3f;dcr;kdc;mos;heic;heif;hif;bmp;gif;tif;tiff;svg;avif;mp4;m4v;mov;webm;avi;mts;m2ts;mkv;3gp;wmv;mpg;mpeg?>
        <RegistryKey Root="HKLM" Key="Software\Classes\.$(var.EXT)\OpenWithProgids">
          <RegistryValue Name="pictkura.Image" Type="string" Value="" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\pictkura.exe\SupportedTypes">
          <RegistryValue Name=".$(var.EXT)" Type="string" Value="" />
        </RegistryKey>
        <?endforeach?>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
