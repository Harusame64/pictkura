<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 版（MSIX）のマニフェスト（pictkura-dev #53。計画は dev/plan.msix.md）。
  `tools/pack-msix.ps1` が {{…}} を埋めて使う。Identity の3つ（Name・Publisher・PublisherDisplayName）は
  Partner Center で名前を予約すると決まる値——それまでは試験用の値で包む。

  - フルトラストの desktop app として動かす（runFullTrust）。任意のフォルダ・リムーバブルは通常の Win32 I/O で読む
  - AutoPlay はここで登録する。パッケージの中から HKCU へ書いても、パッケージ専用の仮想レジストリに入って
    エクスプローラーからは見えない（autoplay.rs の実行時の登録は、パッケージとして動くときは止める）
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop3="http://schemas.microsoft.com/appx/manifest/desktop/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop3 rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>pictkura</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Store が「対応言語」に出し、言語ごとの掲載ページを作れるのはここに書いた言語だけ。
       **画面の辞書（ui/src/i18n/index.ts の DICTS）と揃える**——ui/scripts/i18n.test.ts が突き合わせる。
       ja-JP・en-US は 1.0.0 からの掲載がこの綴りに結びついているので残す。地域で割らない辞書は地域を付けない。
       葡語はブラジルの辞書1つでポルトガルも覆う（pt-PT の掲載にもブラジルの文を出す）。
       綴りは Store の一覧にあるもの（learn.microsoft.com の App package requirements → Supported languages）。
       **掲載ページは日英だけ**（2026-11-04 利用者）。提出のときに Partner Center でほかの言語の掲載を Remove する -->
  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
    <Resource Language="de" />
    <Resource Language="fr" />
    <Resource Language="it" />
    <Resource Language="ru" />
    <Resource Language="es-ES" />
    <Resource Language="es-419" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
    <Resource Language="pt-BR" />
    <Resource Language="pt-PT" />
    <Resource Language="ko" />
    <Resource Language="ar" />
    <Resource Language="he" />
  </Resources>

  <Applications>
    <Application Id="pictkura" Executable="pictkura.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="pictkura"
        Description="写真の取り込みと一覧表示に特化した画像管理"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- 今の実行時の登録（autoplay.rs）と同じ3つの到着イベント。選ばれると、取り込みの引数にドライブを付けて起動する（XML のコメントには二重のハイフンを書けない） -->
        <desktop3:Extension Category="windows.autoPlayHandler">
          <desktop3:AutoPlayHandler>
            <desktop3:InvokeAction ActionDisplayName="pictkura で写真を取り込む" ProviderDisplayName="pictkura">
              <desktop3:Content ContentEvent="ShowPicturesOnArrival" Verb="importpictures" Parameters="--import &quot;%1&quot;" />
              <desktop3:Content ContentEvent="MixedContentOnArrival" Verb="importmixed" Parameters="--import &quot;%1&quot;" />
              <desktop3:Content ContentEvent="StorageOnArrival" Verb="importstorage" Parameters="--import &quot;%1&quot;" />
            </desktop3:InvokeAction>
          </desktop3:AutoPlayHandler>
        </desktop3:Extension>
        <!-- 「プログラムから開く」の候補（2026-11-15 利用者の決定）。Store 版のファイルの種類の宣言は候補になるだけで、
             既定のアプリにはならない。起動の引数（Parameters）は uap3 の側にしか無い（uap では MakeAppx が断る）。拡張子は openwith.wxs・installer-hooks.nsh と同じ一覧 -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="pictkuraimages" Parameters="&quot;%1&quot;">
            <uap:DisplayName>pictkura</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.cr2</uap:FileType>
              <uap:FileType>.cr3</uap:FileType>
              <uap:FileType>.crw</uap:FileType>
              <uap:FileType>.nef</uap:FileType>
              <uap:FileType>.nrw</uap:FileType>
              <uap:FileType>.arw</uap:FileType>
              <uap:FileType>.srf</uap:FileType>
              <uap:FileType>.sr2</uap:FileType>
              <uap:FileType>.arq</uap:FileType>
              <uap:FileType>.raf</uap:FileType>
              <uap:FileType>.orf</uap:FileType>
              <uap:FileType>.ori</uap:FileType>
              <uap:FileType>.rw2</uap:FileType>
              <uap:FileType>.pef</uap:FileType>
              <uap:FileType>.ptx</uap:FileType>
              <uap:FileType>.srw</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.raw</uap:FileType>
              <uap:FileType>.rwl</uap:FileType>
              <uap:FileType>.3fr</uap:FileType>
              <uap:FileType>.fff</uap:FileType>
              <uap:FileType>.iiq</uap:FileType>
              <uap:FileType>.erf</uap:FileType>
              <uap:FileType>.mrw</uap:FileType>
              <uap:FileType>.x3f</uap:FileType>
              <uap:FileType>.dcr</uap:FileType>
              <uap:FileType>.kdc</uap:FileType>
              <uap:FileType>.mos</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.hif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
